# API origin used by the local web application. Do not add secrets to this file.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Public FastF1 and normalized cache locations. Both are ignored by Git.
FASTF1_CACHE_DIR=fastf1-cache
NORMALIZED_CACHE_DIR=normalized-cache

# Comma-separated local origins allowed to call the API from the browser.
CORTEX_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
